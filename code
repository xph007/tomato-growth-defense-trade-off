# 假设ps_dif已经加载并聚合到Genus水平
ps_dif = readRDS("./data/ps_dif.rds") %>% 
  tax_glom_wt("Genus") %>% 
  transform_sample_counts(function(x) x / sum(x))

map <- sample_data(ps_dif) %>% as.tibble()%>% 
  as.data.frame() 


dat <- psmelt(ps_dif) %>%
  as.data.frame() %>%
  select(Abundance, Genus,SampleID) %>%
  filter(Genus != "Unassigned") 
head(dat)

dat <- dat %>%
  left_join(map %>% select(SampleID, group), by = "SampleID") %>%
  filter(group != "CK")

dat_wide <- dat %>%
  select(Genus, SampleID, Abundance) %>%
  spread(key = SampleID, value = Abundance, fill = 0) %>%
  column_to_rownames("Genus")


dat_wide_scaled <- t(scale(t(dat_wide)))
dat_wide_scaled[is.nan(dat_wide_scaled)] <- 0
dat_wide_scaled[is.na(dat_wide_scaled)] <- 0


genus_matrix <- as.matrix(dat_wide_scaled)
dist_matrix <- dist(genus_matrix, method = "euclidean")
hc <- hclust(dist_matrix, method = "complete")

ordered_genus <- hc$labels[hc$order]

mean_abundance <- dat %>%
  group_by(Genus) %>%
  summarise(Mean_Abundance = mean(Abundance, na.rm = TRUE), .groups = "drop") %>%
  mutate(Genus = factor(Genus, levels = ordered_genus))

dat_scaled <- as.data.frame(dat_wide_scaled) %>%
  rownames_to_column("Genus") %>%
  pivot_longer(-Genus, names_to = "SampleID", values_to = "Abundance_zscore") %>%
  left_join(map %>% select(SampleID, group), by = "SampleID")

dat_scaled$Genus <- factor(dat_scaled$Genus, levels = ordered_genus)


tax <- as.data.frame(tax_table(ps_dif))
tax[is.na(tax)] <- "Unclassified"


genus_phylum_map <- data.frame(
  Genus = rownames(tax),
  Phylum = tax$Phylum
)

tree <- as.phylo(hc)


tree_data <- data.frame(
  label = tree$tip.label
) %>%
  left_join(genus_phylum_map, by = c("label" = "Genus"))


unique_phyla <- unique(tree_data$Phylum)
phylum_colors <- setNames(
  scales::hue_pal()(length(unique_phyla)), 
  unique_phyla
)

p_tree <- ggtree(tree, layout = "rectangular") %<+% 
  tree_data +
  geom_tiplab(aes(color = Phylum), size = 1.5, align = FALSE) +
  scale_color_manual(values = phylum_colors) +
  theme_tree2() +
  theme(
    legend.position = "right",
    legend.title = element_text(size = 9, face = "bold"),
    legend.text = element_text(size = 7)
  )
p_tree

stage_list <- c("Seedling_stage", "vegetative_stage", "flowering_stage", "fruit_stage")


stage_colors <- setNames(
  brewer.pal(length(stage_list), "Dark2"),
  stage_list
)

heatmap_list <- list()

for (stage in stage_list) {
  dat_stage <- dat_scaled %>%
    filter(group == stage)
  
  p_heatmap <- ggplot(dat_stage, aes(x = SampleID, y = Genus)) +  
    geom_tile(aes(fill = Abundance_zscore), colour = "#E0E0E0", size = 0.2) +
    scale_fill_gradient2(
      low = "#f0f0f0",
      high = stage_colors[stage],
      midpoint = 0.7,
      limits = c(min(dat_scaled$Abundance_zscore), max(dat_scaled$Abundance_zscore)),
      name = "Z-score"
    ) +
    labs(x = NULL, y = NULL, title = gsub("_", " ", stage)) +
    theme_minimal() +
    theme(
      text = element_text(size = 9, colour = "black"),
      axis.text.y = element_blank(),  
      axis.ticks.y = element_blank(),
      axis.text.x = element_blank(),  
      axis.ticks.x = element_blank(),
      plot.title = element_text(hjust = 0.5, size = 10, face = "bold"),
      legend.position = "none",
      panel.grid = element_blank(),
      plot.margin = margin(2, 1, 2, 1)
    )
  
  heatmap_list[[stage]] <- p_heatmap
}

p_bar <- ggplot(mean_abundance, aes(x = Mean_Abundance, y = Genus)) +
